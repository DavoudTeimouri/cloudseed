  <metadata>
    <id>cloudseed</id>
    <version>2.0.2</version>
    <title>CloudSeed</title>
    <authors>Davoud Teimouri</authors>
    <owners>Davoud Teimouri</owners>
    <licenseUrl>https://github.com/DavoudTeimouri/cloudseed/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/DavoudTeimouri/cloudseed</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/DavoudTeimouri/cloudseed/main/cloudseed.ico</iconUrl>
